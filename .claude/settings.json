{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m ruff check*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv/bin/python -c *)",
      "Bash(.venv/bin/python train.py*)",
      "Bash(.venv/bin/python evaluate.py*)",
      "Bash(.venv/bin/python enhance.py*)",
      "Bash(.venv/bin/pip install -r requirements.txt)",
      "Bash(nvidia-smi*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(gh pr view*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(kaggle.json)",
      "Read(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(kaggle.json)",
      "Edit(secrets/**)"
    ]
  }
}
