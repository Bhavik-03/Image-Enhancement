{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(.venv/bin/python -m ruff check*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv/bin/python -c *)",
      "Bash(nvidia-smi*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git switch*)",
      "Bash(git pull*)",
      "Bash(gh pr view*)",
      "Bash(gh issue list*)"
    ],
    "ask": [
      "Edit(docs/spec.md)",
      "Edit(docs/design.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(kaggle.json)",
      "Read(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(kaggle.json)",
      "Edit(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_shell.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
